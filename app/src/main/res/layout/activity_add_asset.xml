<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Breadcrumb -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ Asset Management"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_asset"
                android:textColor="@color/accent_orange"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_card_border"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_new_asset"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_new_asset"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_asset_name"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etAssetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_focused"
            android:hint="@string/hint_asset_name"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Category -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_category"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbDispatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_dispatch"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_orange"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbEquipment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_equipment"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_orange" />

                    <RadioButton
                        android:id="@+id/rbVehicle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_vehicle"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_orange" />
                </RadioGroup>
            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_status"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbInUse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_in_use"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_orange"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbOutForService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_out_for_service"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_orange" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_quantity"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:text="1"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_notes_optional"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_notes_optional"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_outline"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSaveAsset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/btn_save_asset"
                android:textColor="@color/bg_root"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
